# =========================
# Python cache / compiled files
# =========================
__pycache__/
*.py[cod]
*$py.class

# =========================
# Virtual environments
# =========================
.venv/
venv/
env/

# =========================
# IDE / editor files
# =========================
.vscode/
.idea/

# =========================
# OS files
# =========================
.DS_Store
Thumbs.db

# =========================
# Environment / secrets
# =========================
.env
.env.*
!.env.example

# =========================
# Runtime settings
# Local machine settings should not be committed
# =========================
runtime_settings.json

# =========================
# Logs
# =========================
*.log

# =========================
# Downloaded model files
# YOLO model files can be large
# =========================
*.pt

# =========================
# Video files
# Do not commit local videos or generated videos
# =========================
*.mp4
*.avi
*.mov
*.mkv
*.webm

# =========================
# Runtime uploads
# Keep folder, ignore uploaded files
# =========================
uploads/*
!uploads/.gitkeep

# =========================
# Batch input folders
# Keep folders, ignore runtime video files
# =========================
input_videos/*
!input_videos/.gitkeep
!input_videos/pending/
!input_videos/pending/.gitkeep
!input_videos/processing/
!input_videos/processing/.gitkeep
!input_videos/completed/
!input_videos/completed/.gitkeep
!input_videos/failed/
!input_videos/failed/.gitkeep

# =========================
# Output folders
# Keep folder, ignore generated outputs
# =========================
outputs/*
!outputs/.gitkeep

# =========================
# Local demo videos
# Keep folder, ignore local demo files
# =========================
videos/*
!videos/.gitkeep

# =========================
# Temporary / misc
# =========================
*.tmp
*.bak