# =========================
# Python cache / compiled files
# =========================
__pycache__/
*.py[cod]
*$py.class

# =========================
# Virtual environment
# =========================
.venv/
venv/
env/

# =========================
# IDE / editor files
# =========================
.vscode/
.idea/

# =========================
# OS files
# =========================
.DS_Store
Thumbs.db

# =========================
# Environment / secrets
# =========================
.env

# =========================
# Runtime settings
# =========================
runtime_settings.json

# =========================
# Logs
# =========================
*.log

# =========================
# Downloaded model files
# =========================
*.pt

# =========================
# Runtime uploads
# Keep folder, ignore uploaded files
# =========================
uploads/*
!uploads/.gitkeep

# =========================
# Batch input folders
# Keep folders, ignore runtime video files
# =========================
input_videos/pending/*
!input_videos/pending/.gitkeep

input_videos/processing/*
!input_videos/processing/.gitkeep

input_videos/completed/*
!input_videos/completed/.gitkeep

input_videos/failed/*
!input_videos/failed/.gitkeep

# =========================
# Output folders
# Keep folders, ignore generated outputs
# =========================
outputs/*
!outputs/runs/
outputs/runs/*
!outputs/runs/.gitkeep

# =========================
# Local demo videos
# Shared by ZIP, not GitHub
# =========================
videos/*.mp4

# =========================
# Temporary / misc
# =========================
*.tmp
*.bak